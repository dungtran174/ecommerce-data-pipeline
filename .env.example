# PostgreSQL source
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_local
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432

# Airflow account and metadata database
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=airflow_local
_AIRFLOW_WWW_USER_EMAIL=admin@example.invalid
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_db_local
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_PORT=5433

# Kafka and Debezium ports
KAFKA_PORT=9092
KAFKA_UI_PORT=8085
DEBEZIUM_PORT=8083
DEBEZIUM_UI_PORT=8084

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_local
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000

# Metabase and metadata database
METABASE_PORT=3000
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=metabase_local
METABASE_DB_NAME=metabase
METABASE_DB_PORT=5434
